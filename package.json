{
    "name": "study-buddy",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
        "dev:debug": "LOG_LEVEL=debug npm run dev",
        "dev:agent": "./scripts/run-agent.sh || \"scripts\\run-agent.bat\"",
        "dev:ui": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "install:agent": "./scripts/setup-agent.sh || \"scripts\\setup-agent.bat\"",
        "postinstall": "npm run install:agent",
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@a2a-js/sdk": "^0.2.2",
        "@ag-ui/a2a": "^0.0.6",
        "@ag-ui/client": "0.0.53",
        "@copilotkit/react-core": "^1.57.3",
        "@copilotkit/react-textarea": "^1.57.3",
        "@copilotkit/react-ui": "^1.57.3",
        "@copilotkit/runtime": "^1.57.3",
        "hono": "^4.12.22",
        "next": "^16.2.6",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "shiki": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "concurrently": "^9.1.2",
        "eslint": "^9.39.4",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-airbnb-extended": "^3.1.0",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-next": "^16.2.6",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
