# Agent Dockerfile — TypeScript ADK agent via tsx
FROM node:20-slim

RUN npm install -g pnpm tsx

WORKDIR /app

# Install dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

# Copy agent source
COPY . .

EXPOSE 8000

ENV NODE_ENV=production

CMD ["tsx", "main.ts"]
